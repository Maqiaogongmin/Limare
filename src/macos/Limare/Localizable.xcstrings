          }
        }
      }
    },
    "The permission mode is Full Access: when this task runs unattended, it can read and write files outside the workspace and run commands without sandbox limits." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
